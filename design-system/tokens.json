{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "name": "The Institutes Knowledge Group Design Tokens",
    "source": "TI Design System v2.1 (May 2026), §4 and §12.1",
    "authoritativeWebReference": "web-develop.theinstitutes.org/themes/ti_west/public/style-guide/",
    "scope": ["TIKG", "Agent Broker", "CEU"],
    "rule": "Use these tokens. Never hardcode hex, font, spacing, shadow, radius, or motion values.",
    "todo": "Values flagged confirm:false lack a canonical SCSS variable name or have a source discrepancy; verify against the living style guide before relying on them."
  },
  "color": {
    "brand": {
      "primary-blue": { "value": "#003370", "usage": "Navigation, headers, primary CTAs, body links, section headings" },
      "primary-red": { "value": "#980d22", "usage": "Secondary brand accent; alert/error" },
      "secondary-gray": { "value": "#5c6f7c", "usage": "Subheadings, secondary UI labels, inactive tabs" },
      "secondary-purple": { "value": "#650360", "usage": "AI / emerging-tech designation content ONLY" },
      "text-gray": { "value": "#58595b", "usage": "All body text / default text color" }
    },
    "accent": {
      "blue-light": { "value": "#72ccd2", "usage": "Background accents, teal bands" },
      "blue": { "value": "#218198", "usage": "Secondary interactive, info states" },
      "blue-dark": { "value": "#042246", "usage": "Deep navy; gradient pair" },
      "orange": { "value": "#c05810", "usage": "CTAs, highlights; gradient start" },
      "orange-dark": { "value": "#a63b00", "usage": "H5 uppercase labels; card category labels; gradient end" },
      "yellow": { "value": "#faa634", "usage": "Warning states; promo badges" },
      "red": { "value": "#801129", "usage": "Destructive actions; error UI" },
      "green": { "value": "#6c7d45", "usage": "Success; CEU Unlimited identifier" },
      "blue-alt": { "value": "#19a1c9", "confirm": false, "usage": "Gradient component; note Gradient Blue Light uses #1aa1c9 — source discrepancy" },
      "green-alt": { "value": "#728549", "confirm": false, "usage": "Success hover" },
      "green-dark": { "value": "#185d6e", "confirm": false, "usage": "Success pressed / deep" },
      "lavender": { "value": "#e1ecf5", "confirm": false, "usage": "Card image placeholder; subtle tints" },
      "blue-tint": { "value": "#d0e6e9", "confirm": false, "usage": "Card image placeholder (Blue Light tint)" }
    },
    "neutral": {
      "xlight": { "value": "#f2f2f2", "usage": "Alternating table rows; section backgrounds" },
      "light": { "value": "#eaeaea", "usage": "Borders, dividers, card outlines" },
      "neutral": { "value": "#cdcdcd", "usage": "Form input borders; accordion borders" },
      "medium-dark": { "value": "#6c6c6c", "confirm": false, "usage": "Disabled text" },
      "dark": { "value": "#232323", "usage": "Tooltip backgrounds; near-black text" },
      "black": { "value": "#000000", "usage": "True black — use sparingly" },
      "white": { "value": "#ffffff", "usage": "Primary page + card background" }
    },
    "alert": {
      "red": { "value": "#8b2025", "usage": "Error notifications, critical alerts" },
      "blue": { "value": "#007db8", "usage": "Informational notifications, banners" },
      "warning": { "value": "#faa634", "usage": "Warning (from accent.yellow)" },
      "success": { "value": "#6c7d45", "usage": "Success (from accent.green)" }
    }
  },
  "gradient": {
    "orange": { "value": "linear-gradient(90deg, #c05810 26%, #a63b00 100%)", "usage": "Primary CTA bg; Essentials" },
    "blue": { "value": "linear-gradient(270deg, #007db8 26%, #003370 100%)", "usage": "Hero bands; primary sections" },
    "blue-light": { "value": "linear-gradient(270deg, #1aa1c9 -10%, #006385 100%)", "usage": "CEU + secondary features" },
    "red": { "value": "linear-gradient(270deg, #870e28 26%, #570f21 100%)", "usage": "Alert / urgent promo bands" },
    "purple": { "value": "linear-gradient(270deg, #861e81 26%, #5d0158 100%)", "usage": "AI / emerging-tech sections ONLY" }
  },
  "font": {
    "family": {
      "serif": { "value": "Merriweather, Georgia, serif", "usage": "H1, H3, H4" },
      "sans": { "value": "Montserrat, sans-serif", "usage": "H2, H5, buttons, nav, UI labels" },
      "body": { "value": "'Open Sans', 'Segoe UI', sans-serif", "usage": "Body, forms, captions" }
    },
    "rule": "Exactly three typefaces. Never substitute or add a fourth."
  },
  "typeScale": {
    "h1": { "font": "Merriweather Light", "size": "38px", "modifier": "40px", "lineHeight": 1.58 },
    "h2": { "font": "Montserrat Regular", "size": "36px", "modifier": "38px", "lineHeight": 1.5 },
    "h3": { "font": "Merriweather Regular", "size": "30px", "modifier": "32px", "lineHeight": 1.73 },
    "h4": { "font": "Merriweather Light", "size": "25px", "modifier": "27px", "lineHeight": 1.48 },
    "h5": { "font": "Montserrat Bold", "size": "12px", "modifier": "14px", "lineHeight": 1.5, "transform": "uppercase", "letterSpacing": "1px", "color": "#a63b00" },
    "body": { "font": "Open Sans Regular", "size": "14px", "modifier": "16px", "lineHeight": 1.86 },
    "link": { "color": "#003370", "decoration": "underline", "weight": 700 }
  },
  "spacing": {
    "_base": "16px vertical unit; use multiples of 8px",
    "tight": "8px",
    "base-vertical-margin": "16px",
    "base-margin-bottom": "24px",
    "block": "32px",
    "section": "48px",
    "rhythm": "64px"
  },
  "shadow": {
    "standard": { "value": "0 2px 24px 0 rgba(0,0,0,0.15)", "usage": "Cards, modals, dropdowns — not scaled" },
    "subtle": { "value": "0 2px 8px rgba(0,0,0,0.06)", "usage": "Nav bar, sticky elements" }
  },
  "radius": {
    "none": { "value": "0", "usage": "Cards — intentional square corners; do not round" },
    "sm": { "value": "4px", "usage": "Buttons, inputs, badges, tooltip, modal" },
    "md": { "value": "6px", "usage": "Nav bar; larger decorative containers" },
    "pill": { "value": "9999px", "usage": "Pill badges; circular avatars" }
  },
  "motion": {
    "fast": { "value": "100ms", "usage": "Micro-interactions: checkbox, radio, icon swap" },
    "normal": { "value": "200ms", "usage": "Button states, link underlines, focus rings" },
    "slow": { "value": "350ms", "usage": "Panel slide, accordion expand, card hover" },
    "deliberate": { "value": "500ms", "usage": "Modal enter/exit, page transitions" },
    "rule": "Nothing animates without a user action or state change. Always honor prefers-reduced-motion (set transitions to ~0)."
  },
  "layout": {
    "breakpoints": {
      "mobile": "< 768px",
      "tablet": "768px–1099px",
      "desktop": ">= 1100px"
    },
    "contentMaxWidth": "1280px",
    "grid": { "desktopColumns": 12, "tabletColumns": 2, "mobileColumns": 1, "gutterDesktop": "24px", "gutterTablet": "16px" }
  },
  "accessibility": {
    "standard": "WCAG 2.1 AA",
    "contrast": { "bodyText": "4.5:1", "largeTextAndUi": "3:1" },
    "notes": ["#58595b on #ffffff = 5.9:1 (AA pass)", "#003370 on #ffffff = 12.6:1 (AAA pass)"],
    "rule": "Color is never the only means of communicating information."
  }
}
